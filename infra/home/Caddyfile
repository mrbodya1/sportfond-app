# Connectivity probe only; no application data or authentication over HTTP.
http://94.50.96.146, http://192.168.1.7 {
    header -Server
    handle /sportfond-connectivity {
        respond "Sportfond connection OK" 200
    }
    handle {
        respond "Not found" 404
    }
}

api.sportfondhm.ru {
    request_body {
        max_size 7MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    @api path /api/*
    handle @api {
        reverse_proxy api:8080
    }
    handle {
        respond "Not found" 404
    }
}
